{
  "name": "exaclim",
  "version": "0.2.0",
  "description": "Exaclim worker heat-risk research prototype",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "python3 -m exaclim.server --port 8000",
    "test": "npm run build && python3 -m unittest discover -s tests -v",
    "test:browser": "npm run build && python3 scripts/check_dashboard_v1.py",
    "cloudflare:dev": "NODE_USE_ENV_PROXY=1 XDG_CONFIG_HOME=/workspace/.config EXACLIM_CLOUDFLARE=1 cf dev --port 8787 --host 127.0.0.1",
    "cloudflare:build": "NODE_USE_ENV_PROXY=1 XDG_CONFIG_HOME=/workspace/.config EXACLIM_CLOUDFLARE=1 cf build",
    "cloudflare:check": "tsc --noEmit -p cloudflare/tsconfig.json && NODE_USE_ENV_PROXY=1 XDG_CONFIG_HOME=/workspace/.config EXACLIM_CLOUDFLARE=1 cf deploy --dry-run",
    "deploy": "NODE_USE_ENV_PROXY=1 XDG_CONFIG_HOME=/workspace/.config EXACLIM_CLOUDFLARE=1 cf deploy",
    "test:cloudflare-domain": "node --test tests/cloudflare-domain.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sammydamz/exaclim.git"
  },
  "type": "module",
  "dependencies": {
    "@awesome.me/webawesome": "3.15.0",
    "@fontsource/inter": "5.3.0",
    "@ui-sdk/core": "0.1.0-beta.3",
    "@ui-sdk/web": "0.1.0-beta.3",
    "hono": "4.13.19",
    "lucide": "^1.76.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.2",
    "@cloudflare/workers-types": "5.20261119.1",
    "cf": "1.0.0-rc.2",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
